# Chemin de la base SQLite (libSQL)
DATABASE_URL="file:data/parc.db"

# Jeton d'accès pour une base distante Turso (DATABASE_URL="libsql://…"). Inutile en local.
DATABASE_AUTH_TOKEN=""

# Secret utilisé pour signer les cookies de session (32 caractères minimum)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"

# (Optionnel) Serveur SMTP pour l'envoi des emails de notification.
# Sans configuration, les emails sont affichés dans la console du serveur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Parc Évasion <no-reply@parc-evasion.fr>"
